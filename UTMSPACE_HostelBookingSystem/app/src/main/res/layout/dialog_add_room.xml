<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add New Room"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#800000"
        android:layout_marginBottom="20dp"
        android:fontFamily="sans-serif" />

    <!-- Room Number -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:boxStrokeColor="#800000"
        app:hintTextColor="#800000">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etRoomId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Room Number (e.g., A-101)"
            android:inputType="text"
            android:fontFamily="sans-serif" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Room Type -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:boxStrokeColor="#800000"
        app:hintTextColor="#800000"
        app:endIconMode="custom"
        app:endIconDrawable="@drawable/ic_arrow_down"
        app:endIconTint="#800000">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etRoomType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Room Type"
            android:focusable="false"
            android:clickable="true"
            android:inputType="text"
            android:fontFamily="sans-serif" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Location - Changed to regular text input (no dropdown) -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:boxStrokeColor="#800000"
        app:hintTextColor="#800000">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Location (e.g., Block A, Level 1)"
            android:inputType="text"
            android:fontFamily="sans-serif" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Price -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:boxStrokeColor="#800000"
        app:hintTextColor="#800000">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Price (RM)"
            android:inputType="numberDecimal"
            android:fontFamily="sans-serif" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Max Capacity -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:boxStrokeColor="#800000"
        app:hintTextColor="#800000">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etMaxCapacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Max Capacity"
            android:inputType="number"
            android:fontFamily="sans-serif" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Current Occupancy -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:boxStrokeColor="#800000"
        app:hintTextColor="#800000">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCurrentOccupancy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Current Occupancy"
            android:inputType="number"
            android:text="0"
            android:fontFamily="sans-serif" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/outline_button_background"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#800000"
                android:fontFamily="sans-serif" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnConfirm"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/primary_button_background"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add Room"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>