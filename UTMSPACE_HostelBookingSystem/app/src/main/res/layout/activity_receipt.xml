<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F0EB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:paddingTop="40dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Receipt"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#800000"
            android:gravity="center"
            android:fontFamily="sans-serif" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollViewReceipt"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/receiptContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="24dp"
                android:elevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/ic_receipt_check"
                        app:tint="#10B981" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Payment Successful!"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#10B981"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:id="@+id/tvTransactionId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Transaction ID: TXN202406011234"
                        android:textSize="12sp"
                        android:textColor="#AA7A6C"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEDDD5"
                    android:layout_marginVertical="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Payment Date"
                        android:textSize="13sp"
                        android:textColor="#AA7A6C"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:id="@+id/tvPaymentDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="01 June 2024, 14:30"
                        android:textSize="13sp"
                        android:textColor="#3C2A24"
                        android:fontFamily="sans-serif" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Payment Method"
                        android:textSize="13sp"
                        android:textColor="#AA7A6C"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:id="@+id/tvPaymentMethod"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Credit Card (****1234)"
                        android:textSize="13sp"
                        android:textColor="#3C2A24"
                        android:fontFamily="sans-serif" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Payment Status"
                        android:textSize="13sp"
                        android:textColor="#AA7A6C"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:id="@+id/tvPaymentStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Completed"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#10B981"
                        android:fontFamily="sans-serif" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEDDD5"
                    android:layout_marginVertical="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Room"
                        android:textSize="13sp"
                        android:textColor="#AA7A6C"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:id="@+id/tvRoomName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Single Room"
                        android:textSize="13sp"
                        android:textColor="#3C2A24"
                        android:fontFamily="sans-serif" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Room Number"
                        android:textSize="13sp"
                        android:textColor="#AA7A6C"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:id="@+id/tvRoomNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="A-101"
                        android:textSize="13sp"
                        android:textColor="#3C2A24"
                        android:fontFamily="sans-serif" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Duration"
                        android:textSize="13sp"
                        android:textColor="#AA7A6C"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:id="@+id/tvDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 Semester"
                        android:textSize="13sp"
                        android:textColor="#3C2A24"
                        android:fontFamily="sans-serif" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEDDD5"
                    android:layout_marginVertical="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Subtotal"
                        android:textSize="13sp"
                        android:textColor="#AA7A6C"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:id="@+id/tvSubtotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RM 1500.00"
                        android:textSize="13sp"
                        android:textColor="#3C2A24"
                        android:fontFamily="sans-serif" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Service Charge (6%)"
                        android:textSize="13sp"
                        android:textColor="#AA7A6C"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:id="@+id/tvServiceCharge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RM 90.00"
                        android:textSize="13sp"
                        android:textColor="#3C2A24"
                        android:fontFamily="sans-serif" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEDDD5"
                    android:layout_marginVertical="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Total Amount"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#3C2A24"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:id="@+id/tvTotalAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RM 1590.00"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#800000"
                        android:fontFamily="sans-serif" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEDDD5"
                    android:layout_marginVertical="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Billed To:"
                        android:textSize="12sp"
                        android:textColor="#AA7A6C"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:id="@+id/tvStudentName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alex Chen"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#3C2A24"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:id="@+id/tvStudentEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="alex.chen@university.edu"
                        android:textSize="12sp"
                        android:textColor="#5B6E8C"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:id="@+id/tvStudentPhone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+60 12 345 6789"
                        android:textSize="12sp"
                        android:textColor="#5B6E8C"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnDownloadReceipt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/outline_button_background"
                android:padding="14dp"
                android:gravity="center"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_download"
                    app:tint="#800000"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Download Receipt (PDF)"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#800000"
                    android:fontFamily="sans-serif" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnBackToHome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/primary_button_background"
                android:padding="14dp"
                android:gravity="center"
                android:layout_marginBottom="20dp"
                android:clickable="true"
                android:focusable="true"
                app:backgroundTint="@null">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Back to Home"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:fontFamily="sans-serif" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>