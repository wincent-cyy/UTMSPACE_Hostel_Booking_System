<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <!-- 白色卡片內容 - 填滿整個螢幕 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="24dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="36dp"
        android:gravity="center_vertical">

        <!-- 內容區域 - 垂直居中 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Brand Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="64dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="120dp"
                        android:layout_height="60dp"
                        android:src="@drawable/utmspace_logo" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reset Password"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#800000"
                    android:letterSpacing="-0.02"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="We'll help you regain access"
                    android:textSize="12sp"
                    android:textColor="#AA7A6C"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <!-- Info Text -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enter your registered email to receive a secure reset link."
                android:textSize="13sp"
                android:textColor="#89655A"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="20dp" />

            <!-- Email Input -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email Address"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#B75547"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/input_field_background"
                    android:padding="12dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        app:srcCompat="@drawable/ic_mail"
                        app:tint="#C96B5A" />

                    <EditText
                        android:id="@+id/etResetEmail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:background="@null"
                        android:hint="student@gmail.com"
                        android:textSize="14sp"
                        android:inputType="textEmailAddress"
                        android:fontFamily="sans-serif" />
                </LinearLayout>
            </LinearLayout>

            <!-- Send Reset Link Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/sendResetBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Send reset link"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/primary_button_background"
                android:padding="14dp"
                android:fontFamily="sans-serif"
                android:layout_marginBottom="16dp"
                app:backgroundTint="@null" />

            <!-- Back to Login Link -->
            <TextView
                android:id="@+id/backToLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Back to login"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#B13E2E"
                android:layout_gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="20dp" />

            <!-- Dorm Motif -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Crimson support 24/7"
                    android:textSize="11sp"
                    android:textColor="#B98A7A"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>