<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:elevation="2dp"
    android:layout_marginBottom="10dp"
    android:padding="16dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Top Row: Room Number and Priority -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvRoomNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="A-101"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#3C2A24"
            android:fontFamily="sans-serif" />

        <TextView
            android:id="@+id/tvPriority"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="High"
            android:textSize="10sp"
            android:textStyle="bold"
            android:padding="4dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:background="@drawable/urgency_badge"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif" />

    </LinearLayout>

    <!-- Issue Type -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_warning"
            app:tint="#AA7A6C" />

        <TextView
            android:id="@+id/tvIssueType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Plumbing Issue"
            android:textSize="13sp"
            android:textColor="#5B6E8C"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif" />

    </LinearLayout>

    <!-- Description -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_description"
            app:tint="#AA7A6C" />

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Water leakage from ceiling"
            android:textSize="12sp"
            android:textColor="#5B6E8C"
            android:maxLines="2"
            android:ellipsize="end"
            android:fontFamily="sans-serif" />

    </LinearLayout>

    <!-- Bottom Row: Preferred Time and Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvPreferredTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="09:00 AM"
                android:textSize="11sp"
                android:textColor="#AA7A6C"
                android:fontFamily="sans-serif" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pending"
            android:textSize="10sp"
            android:textStyle="bold"
            android:padding="4dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:background="@drawable/status_badge_pending"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif" />

    </LinearLayout>

</LinearLayout>