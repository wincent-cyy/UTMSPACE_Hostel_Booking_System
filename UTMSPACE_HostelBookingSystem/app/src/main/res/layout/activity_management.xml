<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefreshLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F5F0EB"
        android:fitsSystemWindows="true">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:paddingTop="40dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Management"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#800000"
                    android:layout_marginStart="20dp"
                    android:fontFamily="sans-serif" />

            </LinearLayout>

            <View
                android:layout_width="60dp"
                android:layout_height="3dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="4dp"
                android:background="#800000" />

        </LinearLayout>

        <!-- Tab Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tabBookings"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/filter_chip_selected"
                android:gravity="center"
                android:text="Bookings"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tabRepairs"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/filter_chip_unselected"
                android:gravity="center"
                android:text="Repairs"
                android:textColor="#475569"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- Search Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/search_bar_background"
            android:padding="12dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                app:tint="#7E8B9E" />

            <EditText
                android:id="@+id/etSearchGlobal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@null"
                android:hint="Search by room number..."
                android:textSize="14sp"
                android:inputType="text"
                android:imeOptions="actionDone"
                android:fontFamily="sans-serif" />

            <ImageView
                android:id="@+id/ivClearSearchGlobal"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_close"
                app:tint="#7E8B9E"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Content Area (Scrollable) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/scrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Bookings Section -->
                    <LinearLayout
                        android:id="@+id/bookingsSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <!-- Filter Chips - Bookings -->
                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none"
                            android:layout_marginBottom="12dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/chipAllBookings"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:background="@drawable/filter_chip_selected"
                                    android:gravity="center"
                                    android:paddingStart="16dp"
                                    android:paddingEnd="16dp"
                                    android:text="All"
                                    android:textColor="#FFFFFF"
                                    android:textSize="13sp"
                                    android:layout_marginEnd="8dp"
                                    android:clickable="true"
                                    android:focusable="true" />

                                <TextView
                                    android:id="@+id/chipPendingBookings"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:background="@drawable/filter_chip_unselected"
                                    android:gravity="center"
                                    android:paddingStart="16dp"
                                    android:paddingEnd="16dp"
                                    android:text="Pending"
                                    android:textColor="#475569"
                                    android:textSize="13sp"
                                    android:layout_marginEnd="8dp"
                                    android:clickable="true"
                                    android:focusable="true" />

                                <TextView
                                    android:id="@+id/chipApprovedBookings"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:background="@drawable/filter_chip_unselected"
                                    android:gravity="center"
                                    android:paddingStart="16dp"
                                    android:paddingEnd="16dp"
                                    android:text="Approved"
                                    android:textColor="#475569"
                                    android:textSize="13sp"
                                    android:layout_marginEnd="8dp"
                                    android:clickable="true"
                                    android:focusable="true" />

                                <TextView
                                    android:id="@+id/chipRejectedBookings"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:background="@drawable/filter_chip_unselected"
                                    android:gravity="center"
                                    android:paddingStart="16dp"
                                    android:paddingEnd="16dp"
                                    android:text="Rejected"
                                    android:textColor="#475569"
                                    android:textSize="13sp"
                                    android:layout_marginEnd="8dp"
                                    android:clickable="true"
                                    android:focusable="true" />

                                <TextView
                                    android:id="@+id/chipPaidBookings"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:background="@drawable/filter_chip_unselected"
                                    android:gravity="center"
                                    android:paddingStart="16dp"
                                    android:paddingEnd="16dp"
                                    android:text="Paid"
                                    android:textColor="#475569"
                                    android:textSize="13sp"
                                    android:layout_marginEnd="8dp"
                                    android:clickable="true"
                                    android:focusable="true" />

                            </LinearLayout>
                        </HorizontalScrollView>

                        <!-- Counter Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:id="@+id/tvBookingCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 bookings"
                                android:textSize="13sp"
                                android:textColor="#AA7A6C"
                                android:background="#FEF3F2"
                                android:padding="4dp"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp" />

                        </LinearLayout>

                        <!-- Bookings Container -->
                        <LinearLayout
                            android:id="@+id/bookingsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                    </LinearLayout>

                    <!-- Repairs Section -->
                    <LinearLayout
                        android:id="@+id/repairsSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <!-- Filter Chips - Repairs -->
                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none"
                            android:layout_marginBottom="12dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/chipAllRepairs"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:background="@drawable/filter_chip_selected"
                                    android:gravity="center"
                                    android:paddingStart="16dp"
                                    android:paddingEnd="16dp"
                                    android:text="All"
                                    android:textColor="#FFFFFF"
                                    android:textSize="13sp"
                                    android:layout_marginEnd="8dp"
                                    android:clickable="true"
                                    android:focusable="true" />

                                <TextView
                                    android:id="@+id/chipPendingRepairs"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:background="@drawable/filter_chip_unselected"
                                    android:gravity="center"
                                    android:paddingStart="16dp"
                                    android:paddingEnd="16dp"
                                    android:text="Pending"
                                    android:textColor="#475569"
                                    android:textSize="13sp"
                                    android:layout_marginEnd="8dp"
                                    android:clickable="true"
                                    android:focusable="true" />

                                <TextView
                                    android:id="@+id/chipInProgressRepairs"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:background="@drawable/filter_chip_unselected"
                                    android:gravity="center"
                                    android:paddingStart="16dp"
                                    android:paddingEnd="16dp"
                                    android:text="In Progress"
                                    android:textColor="#475569"
                                    android:textSize="13sp"
                                    android:layout_marginEnd="8dp"
                                    android:clickable="true"
                                    android:focusable="true" />

                                <TextView
                                    android:id="@+id/chipCompletedRepairs"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:background="@drawable/filter_chip_unselected"
                                    android:gravity="center"
                                    android:paddingStart="16dp"
                                    android:paddingEnd="16dp"
                                    android:text="Completed"
                                    android:textColor="#475569"
                                    android:textSize="13sp"
                                    android:layout_marginEnd="8dp"
                                    android:clickable="true"
                                    android:focusable="true" />

                            </LinearLayout>
                        </HorizontalScrollView>

                        <!-- Counter Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:id="@+id/tvRepairCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 requests"
                                android:textSize="13sp"
                                android:textColor="#AA7A6C"
                                android:background="#FEF3F2"
                                android:padding="4dp"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp" />

                        </LinearLayout>

                        <!-- Repairs Container -->
                        <LinearLayout
                            android:id="@+id/repairsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                    </LinearLayout>

                    <!-- Empty State -->
                    <LinearLayout
                        android:id="@+id/emptyState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="40dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvEmptyTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No Bookings Found"
                            android:textSize="16sp"
                            android:textColor="#AA7A6C"
                            android:fontFamily="sans-serif" />

                        <TextView
                            android:id="@+id/tvEmptySubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No bookings available at the moment"
                            android:textSize="13sp"
                            android:textColor="#C4B5A5"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif" />

                    </LinearLayout>

                </LinearLayout>

            </ScrollView>

        </FrameLayout>

        <!-- Bottom Navigation Bar -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bottom_nav_background"
            app:menu="@menu/admin_nav_menu"
            app:itemIconTint="@drawable/nav_item_active"
            app:itemTextColor="@drawable/nav_item_active"
            app:itemRippleColor="@android:color/transparent"
            app:elevation="0dp" />

    </LinearLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>