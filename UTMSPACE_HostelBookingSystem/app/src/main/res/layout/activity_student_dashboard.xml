<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9"
    tools:context=".StudentDashboardActivity">

    <!-- Premium Curved Header -->
    <View
        android:id="@+id/topHeaderBg"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:background="@drawable/dashboard_gradient"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/headerTextLayer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Profile Section -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Good Morning,"
                    android:textColor="#C7D2FE"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/tvStudentName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alex Johnson"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentEnd="true"
                android:padding="2dp"
                android:src="@android:drawable/ic_menu_gallery"
                app:shapeAppearanceOverlay="@style/CircleImage"
                app:strokeColor="#FFFFFF"
                app:strokeWidth="2dp" />
        </RelativeLayout>

        <!-- Search Bar -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="54dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="#FFFFFF">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingStart="20dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="#6366F1" />
                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Find a room ..."
                    android:background="@android:color/transparent"
                    android:paddingStart="12dp"
                    android:textSize="15sp"
                    android:textColorHint="#94A3B8"
                    android:inputType="text"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- FIXED Promotion Banner (Moved outside ScrollView) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/fixedNewsBanner"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_margin="20dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/headerTextLayer">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#EEF2FF">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_centerVertical="true"
                android:layout_marginStart="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hostel News"
                    android:textColor="#4F46E5"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:text="Room renewal starts next week. Book early for discounts!"
                    android:textColor="#3730A3"
                    android:textSize="13sp" />
            </LinearLayout>
            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="10dp"
                android:alpha="0.2"
                android:src="@android:drawable/ic_dialog_info" />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <!-- Scrollable Area for Categories Only -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintTop_toBottomOf="@id/fixedNewsBanner">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Room Categories"
                android:textColor="#1E293B"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingEnd="20dp">

                    <!-- Single Room -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardSingle"
                        android:layout_width="160dp"
                        android:layout_height="210dp"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="6dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="120dp"
                                android:scaleType="centerCrop"
                                android:background="#E2E8F0"
                                android:src="@drawable/single_room" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Premium Single"
                                android:paddingTop="12dp"
                                android:paddingStart="14dp"
                                android:textStyle="bold"
                                android:textColor="#1E293B"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Full Privacy"
                                android:textSize="12sp"
                                android:layout_marginStart="14dp"
                                android:textColor="#6366F1"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Double Room -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardDouble"
                        android:layout_width="160dp"
                        android:layout_height="210dp"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="6dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="120dp"
                                android:scaleType="centerCrop"
                                android:background="#E2E8F0"
                                android:src="@drawable/double_room" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Shared Double"
                                android:paddingTop="12dp"
                                android:paddingStart="14dp"
                                android:textStyle="bold"
                                android:textColor="#1E293B"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Best Value"
                                android:textSize="12sp"
                                android:layout_marginStart="14dp"
                                android:textColor="#10B981"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Quad Room -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardQuad"
                        android:layout_width="160dp"
                        android:layout_height="210dp"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="6dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="120dp"
                                android:scaleType="centerCrop"
                                android:background="#E2E8F0"
                                android:src="@drawable/quad_room" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Quad Room"
                                android:paddingTop="12dp"
                                android:paddingStart="14dp"
                                android:textStyle="bold"
                                android:textColor="#1E293B"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Group Living"
                                android:textSize="12sp"
                                android:layout_marginStart="14dp"
                                android:textColor="#F59E0B"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation - Height increased and Label Visibility set -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:background="@android:color/white"
        android:paddingBottom="8dp"
        app:elevation="32dp"
        app:itemIconTint="#6366F1"
        app:itemTextColor="#64748B"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>