<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F0EB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:paddingTop="30dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:id="@+id/ivBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/back_button_background"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginStart="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="#1E293B" />

            </LinearLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Payment"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#800000"
                android:gravity="center"
                android:fontFamily="sans-serif" />

            <View
                android:layout_width="40dp"
                android:layout_height="1dp" />

        </LinearLayout>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="20dp"
                android:elevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="20dp"
                        android:background="#800000" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" Order Summary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#3C2A24"
                        android:layout_marginStart="10dp"
                        android:fontFamily="sans-serif" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Room"
                        android:textSize="13sp"
                        android:textColor="#AA7A6C"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:id="@+id/tvRoomName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Single Room"
                        android:textSize="14sp"
                        android:textColor="#3C2A24"
                        android:fontFamily="sans-serif" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Room Number"
                        android:textSize="13sp"
                        android:textColor="#AA7A6C"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:id="@+id/tvRoomNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="A-101"
                        android:textSize="14sp"
                        android:textColor="#3C2A24"
                        android:fontFamily="sans-serif" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Duration"
                        android:textSize="13sp"
                        android:textColor="#AA7A6C"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:id="@+id/tvDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 Semester"
                        android:textSize="14sp"
                        android:textColor="#3C2A24"
                        android:fontFamily="sans-serif" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEDDD5"
                    android:layout_marginVertical="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Total Amount"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#3C2A24"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:id="@+id/tvTotalAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RM 1500"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#800000"
                        android:fontFamily="sans-serif" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="20dp"
                android:elevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="20dp"
                        android:background="#800000" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" Select Payment Method"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#3C2A24"
                        android:layout_marginStart="10dp"
                        android:fontFamily="sans-serif" />

                </LinearLayout>

                <RadioGroup
                    android:id="@+id/paymentMethodGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">

                    <RadioButton
                        android:id="@+id/radioCard"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="   Credit / Debit Card"
                        android:drawableStart="@drawable/ic_card"
                        android:drawablePadding="12dp"
                        android:buttonTint="#800000"
                        android:textColor="#3C2A24"
                        android:fontFamily="sans-serif" />

                    <RadioButton
                        android:id="@+id/radioFPX"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="   FPX (Online Banking)"
                        android:drawableStart="@drawable/ic_bank"
                        android:drawablePadding="12dp"
                        android:buttonTint="#800000"
                        android:textColor="#3C2A24"
                        android:fontFamily="sans-serif" />

                    <RadioButton
                        android:id="@+id/radioEWallet"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="   E-Wallet"
                        android:drawableStart="@drawable/ic_wallet"
                        android:drawablePadding="12dp"
                        android:buttonTint="#800000"
                        android:textColor="#3C2A24"
                        android:fontFamily="sans-serif" />

                    <RadioButton
                        android:id="@+id/radioQR"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="   QR Code (DuitNow)"
                        android:drawableStart="@drawable/ic_qr"
                        android:drawablePadding="12dp"
                        android:buttonTint="#800000"
                        android:textColor="#3C2A24"
                        android:fontFamily="sans-serif" />

                </RadioGroup>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/fpxSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="20dp"
                android:elevation="2dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="20dp"
                        android:background="#800000" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" Select Bank"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#3C2A24"
                        android:layout_marginStart="10dp"
                        android:fontFamily="sans-serif" />

                </LinearLayout>

                <Spinner
                    android:id="@+id/spinnerBank"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/spinner_background"
                    android:entries="@array/bank_list"
                    android:fontFamily="sans-serif" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ewalletSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="20dp"
                android:elevation="2dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="20dp"
                        android:background="#800000" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" Select E-Wallet"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#3C2A24"
                        android:layout_marginStart="10dp"
                        android:fontFamily="sans-serif" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:id="@+id/btnTouchNGo"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/wallet_button_background"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_tng"
                            app:tint="#0056B3" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Touch 'n Go"
                            android:textSize="11sp"
                            android:textColor="#3C2A24"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif" />

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvSelectedWallet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="12sp"
                    android:textColor="#800000"
                    android:gravity="center"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/qrSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="20dp"
                android:elevation="2dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                android:gravity="center_horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="20dp"
                        android:background="#800000" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" Scan QR Code"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#3C2A24"
                        android:layout_marginStart="10dp"
                        android:fontFamily="sans-serif" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/ivQRCode"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:src="@drawable/ic_qr_code_sample"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scan with your banking app"
                    android:textSize="12sp"
                    android:textColor="#AA7A6C"
                    android:fontFamily="sans-serif" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnPayNow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/primary_button_background"
                android:padding="14dp"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"
                android:clickable="true"
                android:focusable="true"
                app:backgroundTint="@null">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pay Now"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:fontFamily="sans-serif" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>