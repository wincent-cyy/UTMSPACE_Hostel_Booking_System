<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9"
    tools:context=".StaffRoomListActivity">

    <!-- Header Background -->
    <View
        android:id="@+id/topHeaderBg"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:background="@drawable/dashboard_gradient"
        app:layout_constraintTop_toTopOf="parent" />

    <RelativeLayout
        android:id="@+id/headerTextLayer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingTop="36dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Room Management"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Manage all hostel rooms"
                android:textColor="#C7D2FE"
                android:textSize="13sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Search Bar -->
    <androidx.cardview.widget.CardView
        android:id="@+id/searchCard"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginHorizontal="20dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="@id/topHeaderBg"
        app:layout_constraintTop_toBottomOf="@id/topHeaderBg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingStart="20dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="#6366F1" />

            <EditText
                android:id="@+id/etSearchRoom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:hint="Search by room number..."
                android:paddingStart="12dp"
                android:textSize="14sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Filter Chips -->
    <LinearLayout
        android:id="@+id/filterContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toBottomOf="@id/searchCard">

        <TextView
            android:id="@+id/chipAll"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/filter_chip_selected"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="All"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipAvailable"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/filter_chip_unselected"
            android:gravity="center"
            android:paddingHorizontal="18dp"
            android:text="Available"
            android:textColor="#475569"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipFull"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/filter_chip_unselected"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="Full"
            android:textColor="#475569"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipMaintenance"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/filter_chip_unselected"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="Maintenance"
            android:textColor="#475569"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Room Count -->
    <TextView
        android:id="@+id/tvRoomCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:text="0 rooms found"
        android:textColor="#64748B"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/filterContainer" />

    <!-- Room List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRoomList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintTop_toBottomOf="@id/tvRoomCount" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintTop_toBottomOf="@id/filterContainer">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@android:drawable/ic_menu_gallery"
            app:tint="#CBD5E1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="No rooms found"
            android:textColor="#94A3B8" />
    </LinearLayout>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        style="@style/BottomNavStyle"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        app:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/staff_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>