<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Resend Verification Email"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#800000"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Verification email will be sent to:"
        android:textSize="13sp"
        android:textColor="#666666" />

    <TextView
        android:id="@+id/tvResendEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#800000"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:textColor="#D97706"
        android:layout_marginBottom="20dp" />

    <!-- Resend Button - 使用 primary_button_background (maroon/brown) -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnResend"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Resend Verification Email"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/primary_button_background"
        android:layout_marginBottom="12dp" />

    <!-- Change Email Button - 使用 outline 样式 (边框, 文字颜色 #800000) -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnChangeEmail"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Use Different Email"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#800000"
        android:background="@drawable/outline_button_background" />

</LinearLayout>