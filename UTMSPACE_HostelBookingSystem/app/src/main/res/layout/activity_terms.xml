<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- 白色卡片內容 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="24dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="36dp">

            <!-- Brand Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="64dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="120dp"
                        android:layout_height="60dp"
                        android:src="@drawable/utmspace_logo" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Terms and Conditions"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#800000"
                    android:letterSpacing="-0.02"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Official Policies"
                    android:textSize="12sp"
                    android:textColor="#AA7A6C"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <!-- Terms Content Scroll -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:scrollbars="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingEnd="8dp">

                    <!-- Section 1 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1. General Policies"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#AA3E2E"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Redwood Dormitory provides safe, inclusive accommodation for enrolled students. By using this platform, you agree to comply with all dormitory regulations, including quiet hours, cleanliness standards, and community guidelines. Any violation may lead to probation or contract termination."
                        android:textSize="13sp"
                        android:textColor="#4C352C"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="16dp" />

                    <!-- Section 2 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2. Booking &amp; Payment"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#AA3E2E"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Room reservations are confirmed upon full payment of the semester fee. Late payments may incur additional charges (5% per week). Refund requests must be submitted within 14 days of booking; administrative fees may apply."
                        android:textSize="13sp"
                        android:textColor="#4C352C"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="16dp" />

                    <!-- Section 3 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3. Code of Conduct"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#AA3E2E"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Residents are expected to respect fellow students and staff. Any form of harassment, damage to property, or violation of safety rules (including fire hazards) will result in immediate review and possible expulsion from the dormitory without refund."
                        android:textSize="13sp"
                        android:textColor="#4C352C"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="16dp" />

                    <!-- Section 4 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4. Privacy &amp; Data Protection"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#AA3E2E"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your personal information (name, student ID, email, emergency contact) is used solely for housing administration, maintenance, and safety alerts. Redwood never shares data with third parties without explicit consent, except where required by law."
                        android:textSize="13sp"
                        android:textColor="#4C352C"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="16dp" />

                    <!-- Section 5 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5. Room Maintenance &amp; Damages"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#AA3E2E"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Students must report any damages or technical issues promptly. Intentional damage will be billed to the resident. Routine maintenance is free of charge."
                        android:textSize="13sp"
                        android:textColor="#4C352C"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="16dp" />

                    <!-- Section 6 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6. Amendments to Terms"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#AA3E2E"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Redwood reserves the right to update these terms with prior notice via email or dashboard announcement. Continued occupancy implies acceptance of updated terms."
                        android:textSize="13sp"
                        android:textColor="#4C352C"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="16dp" />

                    <!-- Last Updated -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Last updated: May 2026"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#AA3E2E"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="16dp" />

                </LinearLayout>
            </ScrollView>

            <!-- Back Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/backToLoginFromTermsBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="I understand &amp; go back"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#B13E2E"
                android:background="@drawable/outline_button_background"
                android:padding="14dp"
                android:fontFamily="sans-serif"
                app:backgroundTint="@null" />

            <!-- Dorm Motif -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Crimson support 24/7"
                    android:textSize="11sp"
                    android:textColor="#B98A7A"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>