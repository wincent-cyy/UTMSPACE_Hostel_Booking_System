<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:elevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvRoomName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Single Room"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#3C2A24"
            android:fontFamily="sans-serif" />

        <TextView
            android:id="@+id/tvTotalPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RM 1500"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#800000"
            android:fontFamily="sans-serif" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Check-in: 01/06/2024"
        android:textSize="13sp"
        android:textColor="#AA7A6C"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif" />

    <TextView
        android:id="@+id/tvGuestInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Alex Chen | +60 12 345 6789"
        android:textSize="13sp"
        android:textColor="#5B6E8C"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pending"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#D97706"
            android:background="#FEF3C7"
            android:padding="4dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Details"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#800000"
            android:padding="6dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>